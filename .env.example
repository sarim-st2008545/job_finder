# Copy this file to `.env` and fill in only the providers you intend to use.
# .env is gitignored. Never commit real secrets.

# --- LLM Providers (pick any; matcher/company agents auto-fallback to mock if empty) ---
LLM_PROVIDER=mock          # one of: openai | anthropic | ollama | mock
LLM_MODEL=gpt-4o-mini      # provider-specific model name; ignored for mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Optional integrations (phase 2+) ---
GOOGLE_OAUTH_CLIENT_JSON=
HUNTER_API_KEY=

# --- App ---
LOG_LEVEL=INFO
USER_AGENT=jobfinder/0.1 (+local)
